{
  "name": "codesignal-practice-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Timed, level-gated practice for CodeSignal's React + TypeScript assessments. Specs run like the hidden grader.",
  "scripts": {
    "dev": "vite",
    "level": "node scripts/level.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "verify": "tsc --noEmit -p . && node scripts/level.mjs --all --solution"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
