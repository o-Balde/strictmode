{"id":"bc-087","statement":"Under `strictFunctionTypes` this assignment is rejected.","truth":true,"explanation":"`handleAnimal` promises to accept **any** `Animal`, but `handleDog` calls `bark()`. Parameters are checked contravariantly, so a narrower handler cannot stand in for a wider one.","level":"senior","category":"typescript","subject":"types","codeSnippet":"type Animal = { name: string };\ntype Dog = Animal & { bark(): void };\nlet handleAnimal: (a: Animal) => void;\nconst handleDog = (d: Dog) => d.bark();\nhandleAnimal = handleDog;","codeLanguage":"typescript","codeHtml":"<span style=\"color:#FF79C6\">type</span><span style=\"color:#8BE9FD;font-style:italic\"> Animal</span><span style=\"color:#FF79C6\"> =</span><span style=\"color:#F8F8F2\"> { name</span><span style=\"color:#FF79C6\">:</span><span style=\"color:#8BE9FD;font-style:italic\"> string</span><span style=\"color:#F8F8F2\"> };</span><br><span style=\"color:#FF79C6\">type</span><span style=\"color:#8BE9FD;font-style:italic\"> Dog</span><span style=\"color:#FF79C6\"> =</span><span style=\"color:#8BE9FD;font-style:italic\"> Animal</span><span style=\"color:#FF79C6\"> &#x26;</span><span style=\"color:#F8F8F2\"> { </span><span style=\"color:#50FA7B\">bark</span><span style=\"color:#F8F8F2\">()</span><span style=\"color:#FF79C6\">:</span><span style=\"color:#8BE9FD;font-style:italic\"> void</span><span style=\"color:#F8F8F2\"> };</span><br><span style=\"color:#FF79C6\">let</span><span style=\"color:#50FA7B\"> handleAnimal</span><span style=\"color:#FF79C6\">:</span><span style=\"color:#F8F8F2\"> (</span><span style=\"color:#FFB86C;font-style:italic\">a</span><span style=\"color:#FF79C6\">:</span><span style=\"color:#8BE9FD;font-style:italic\"> Animal</span><span style=\"color:#F8F8F2\">) </span><span style=\"color:#FF79C6\">=></span><span style=\"color:#8BE9FD;font-style:italic\"> void</span><span style=\"color:#F8F8F2\">;</span><br><span style=\"color:#FF79C6\">const</span><span style=\"color:#50FA7B\"> handleDog</span><span style=\"color:#FF79C6\"> =</span><span style=\"color:#F8F8F2\"> (</span><span style=\"color:#FFB86C;font-style:italic\">d</span><span style=\"color:#FF79C6\">:</span><span style=\"color:#8BE9FD;font-style:italic\"> Dog</span><span style=\"color:#F8F8F2\">) </span><span style=\"color:#FF79C6\">=></span><span style=\"color:#F8F8F2\"> d.</span><span style=\"color:#50FA7B\">bark</span><span style=\"color:#F8F8F2\">();</span><br><span style=\"color:#F8F8F2\">handleAnimal </span><span style=\"color:#FF79C6\">=</span><span style=\"color:#F8F8F2\"> handleDog;</span>"}